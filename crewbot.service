[Unit]
Description=CrewBot
After=network.target

[Service]
EnvironmentFile=/etc/environment
ExecStart=/root/CrewBot/venv/bin/python main.py
ExecReload=/root/CrewBot/venv/bin/python main.py
WorkingDirectory=/root/CrewBot/
KillMode=process
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
