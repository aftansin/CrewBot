# --- Telegram ---
BOT_TOKEN=123456:AA...
# Через запятую. Можно несколько.
ADMIN_IDS=438391677

# --- База данных ---
POSTGRES_USER=crewbot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crewbot
DATABASE_URL=postgresql+asyncpg://crewbot:change-me@db:5432/crewbot

# --- Календарь ---
ICS_URL_PREFIX=https://crew.aeroflot.ru/api/calendar/ics/
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3

# --- Опрос ---
POLL_INTERVAL_MINUTES=180
POLL_INTERVAL_MIN_MINUTES=15
POLL_INTERVAL_MAX_MINUTES=1440
POLL_JITTER_SECONDS=300

# --- Предохранитель от обрезанной ленты ---
CANCEL_GUARD_RATIO=0.5
CANCEL_GUARD_MIN_EVENTS=4

# --- Прочее ---
DEFAULT_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# --- Прокси для запросов к календарю (необязательно) ---
# Запросы к crew.aeroflot.ru пойдут через эти узлы, случайно выбирая один.
# Пусто — напрямую со шведского сервера. Формат:
#   socks5://host:port  или  http://host:port
#   с логином: socks5://user:pass@host:port
# Несколько через запятую.
CALENDAR_PROXIES=
